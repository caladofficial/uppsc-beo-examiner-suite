# =============================================================================
# UPPSC BEO Answer-Sheet Scanner & Rubric Grader — Environment Template
# Copy to .env.local for local development. NEVER commit real secret values.
# =============================================================================

# Browser-safe Supabase public configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_placeholder_only

# Server-only Supabase credentials (NEVER expose in NEXT_PUBLIC_ or client bundles)
SUPABASE_SERVICE_ROLE_KEY=sbp_server_only_placeholder
SUPABASE_DB_URL=postgresql://postgres:placeholder@db.your-project-ref.supabase.co:5432/postgres

# Isolated OCR/HTR & Grading Worker Service
OCR_WORKER_URL=http://127.0.0.1:8000
OCR_WORKER_AUTH_TOKEN=worker_shared_hmac_placeholder

# Server-only Model & Search Provider Keys (Loaded server-side only)
GEMINI_API_KEY=your_gemini_api_key_placeholder
GROQ_API_KEY=your_groq_api_key_placeholder
MISTRAL_API_KEY=your_mistral_api_key_placeholder
COHERE_API_KEY=your_cohere_api_key_placeholder
CEREBRAS_API_KEY=your_cerebras_api_key_placeholder
OPENROUTER_API_KEY=your_openrouter_api_key_placeholder
NVIDIA_API_KEY=your_nvidia_api_key_placeholder
SAMBANOVA_API_KEY=your_sambanova_api_key_placeholder
HUGGINGFACE_TOKEN=your_hf_token_placeholder
SEARCH_API_KEY=your_allowlisted_search_api_key_placeholder

# Deployment Token (Gated — Do NOT run production deploy without explicit user approval)
VERCEL_TOKEN=vcp_deployment_placeholder_only
